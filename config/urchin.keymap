#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hm: balanced_homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        unstick: unstick {
            label = "ZM_unstick";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT &kp RSHIFT &kp LCTRL &kp RCTRL &kp LALT &kp RALT &kp LGUI &kp RGUI>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_settings1 {
            timeout-ms = <200>;
            key-positions = <21 22 23>;
            bindings = <&mo 5>;
        };

        combo_settings2 {
            bindings = <&mo 5>;
            key-positions = <26 27 28>;
            timeout-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty {
            label = "base";
            bindings = <
  &kp Q  &kp D           &kp R           &kp W               &kp B               &kp J              &kp F                &kp U            &kp P            &kp BSLH
  &kp A  &hm LEFT_GUI S  &hm LEFT_ALT H  &hm LEFT_CONTROL T  &hm LEFT_SHIFT G    &hm RIGHT_SHIFT Y  &hm RIGHT_CONTROL N  &hm RIGHT_ALT E  &hm RIGHT_GUI O  &kp I
  &kp Z  &kp X           &kp M           &kp C               &kp V               &kp K              &kp L                &kp COMMA        &kp DOT          &kp SLASH
                                         &lt 2 ENTER         &lt 1 TAB           &lt 4 SPACE        &lt 3 BACKSPACE
            >;
        };

        numfun_layer {
            label = "num";
            bindings = <
  &kp GRAVE  &kp F1        &kp F2        &kp F3            &kp F4            &kp LEFT_ARROW   &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp RC(BACKSLASH)
  &kp CAPS   &sk LEFT_GUI  &sk LEFT_ALT  &sk LEFT_CONTROL  &sk LEFT_SHIFT    &kp N9           &kp N1          &kp N2        &kp N3           &kp N4
  &kp ESC    &kp F5        &kp F6        &kp F7            &kp F8            &kp N0           &kp N5          &kp N6        &kp N7           &kp N8
                                         &trans            &trans            &kp RIGHT_SHIFT  &kp RCTRL
            >;
        };

        navigation_layer {
            label = "navi";
            bindings = <
  &kp GRAVE     &kp F9          &kp F10       &kp F11           &kp F12            &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp RC(BACKSLASH)
  &kp CAPSLOCK  &sk LEFT_GUI    &sk LEFT_ALT  &sk LEFT_CONTROL  &sk RIGHT_SHIFT    &kp H           &kp J           &kp K         &kp L            &kp ENTER
  &kp ESCAPE    &kp LEFT_ARROW  &kp DOWN      &kp UP_ARROW      &kp RIGHT          &kp HOME        &kp PAGE_DOWN   &kp PG_UP     &kp END          &kp DELETE
                                              &trans            &trans             &trans          &trans
            >;
        };

        symbols1_layer {
            label = "sym1";
            bindings = <
  &kp GRAVE     &kp F9          &kp F10         &kp F11       &kp F12            &kp LEFT_ARROW         &kp DOWN_ARROW   &kp UP_ARROW  &kp RIGHT      &kp RC(BACKSLASH)
  &kp CAPSLOCK  &kp LGUI        &kp LALT        &kp LCTRL     &kp LSHFT          &kp LEFT_PARENTHESIS   &kp EXCLAMATION  &kp AT_SIGN   &kp HASH       &kp DOLLAR
  &kp ESCAPE    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW    &kp RIGHT_PARENTHESIS  &kp PERCENT      &kp CARET     &kp AMPERSAND  &kp ASTERISK
                                                &trans        &trans             &trans                 &trans
            >;
        };

        symbols2_layer {
            label = "sym2";
            bindings = <
  &kp GRAVE     &kp F1          &kp F2          &kp F3            &kp F4             &kp F5    &kp F6          &kp F7     &kp F8         &kp RC(BACKSLASH)
  &kp CAPSLOCK  &kp LGUI        &kp LALT        &kp LCTRL         &kp LSHFT          &kp LBKT  &kp MINUS       &kp EQUAL  &kp SEMICOLON  &kp SINGLE_QUOTE
  &kp ESCAPE    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW      &kp RIGHT_ARROW    &kp RBKT  &kp UNDERSCORE  &kp PLUS   &kp COLON      &kp DOUBLE_QUOTES
                                                &kp LEFT_CONTROL  &kp LEFT_SHIFT     &trans    &trans
            >;
        };

        settings_layer {
            label = "settings";
            bindings = <
  &bootloader  &bt BT_CLR_ALL  &bt BT_CLR  &none  &none           &none         &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &kp K_MUTE    &bootloader
  &none        &none           &none       &none  &none           &bt BT_SEL 0  &bt BT_SEL 1     &bt BT_SEL 2       &bt BT_SEL 3  &bt BT_SEL 4
  &none        &none           &none       &none  &none           &none         &none            &none              &none         &none
                                           &none  &kp CAPSLOCK    &kp CAPSLOCK  &none
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
